[Unit]
Description=pkg.so package web origin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=automic-vault-web
Group=automic-vault-web
WorkingDirectory=/apps/automic-vault-web/current
EnvironmentFile=/etc/automic-vault-web.env
ExecStart=/apps/automic-vault-web/current/av-web
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/automic-vault-web

[Install]
WantedBy=multi-user.target
